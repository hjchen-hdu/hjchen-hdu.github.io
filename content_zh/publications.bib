@article{chen2026st,
  title={ST-TGExplainer: Disentangling Stability and Transition Patterns for Temporal GNN Interpretability},
  author={Chen, Hongjiang and Zheng, Xin and Jiao, Pengfei and Liu, Huan and Zhao, Zhidong and Wu, Huaming and Xia, Feng and Pan, Shirui},
  journal={International Conference on Machine Learning},
  year={2026},
  selected = {true},
  paper =  {https://arxiv.org/abs/2605.19822},
  abstract = {Temporal graph neural networks (TGNNs) have gained significant traction for solving real-world temporal graph tasks. However, their interpretability remains limited, as most TGNNs fail to identify which historical interactions most influence a given prediction. Despite promising progress on interpretable TGNNs, existing methods predominantly focus on previously seen historical interactions, which we term stability patterns, while overlooking newly emerging first-time interactions, which we term transition patterns. Both types of patterns are essential for faithful temporal explanations. To address this limitation, we propose ST-TGExplainer, a self-explainable TGNN that disentangles Stability and Transition patterns in temporal graphs for a more faithful Temporal GNN Explainer. Guided by a disentangled information bottleneck objective, ST-TGExplainer learns a compact explanatory subgraph that remains predictive of the event label while explicitly suppressing label-conditioned redundancy between stability and transition patterns. Extensive experiments demonstrate that ST-TGExplainer achieves strong predictive performance and yields more faithful explanations. },
  rank = {CCF-A},
  code = {https://github.com/hjchen-hdu/ST-TGExplainer},
}

@article{chen2026lgat,
  title={LGAT: Towards Local-Global Adaptive Temporal Graph Representation Learning},
  author={Chen, Hongjiang and Jiao, Pengfei and Guo, Xuan and Gao, Mengzhou and Zhao, Zhidong},
  journal={IEEE Transactions on Artificial Intelligence},
  year={2026},
  publisher={IEEE},
  selected = {true},
  paper = {https://ieeexplore.ieee.org/abstract/document/11488184/},
  abstract = {Temporal graph representation learning aims to model evolving networks by embedding nodes with respect to their dynamic interactions and attributes over time. Real-world temporal graphs typically exhibit power-law degree distributions, where a small subset of high-degree nodes dominates interactions while the majority of low-degree nodes maintain sparse connections. This inherent imbalance, characterized by node heterogeneity and edge sparsity, poses fundamental challenges: existing approaches that rely on first-order neighborhood aggregation cannot adequately represent under-connected nodes, and the limited number of observed edges restricts the availability of supervision signals. To address these challenges, we propose Local-Global Adaptive Temporal Graph representation learning (LGAT), which integrates local topological features with global evolutionary semantics. The core insight is that local neighborhood information alone is insufficient for heterogeneous networks, while a purely global perspective risks over-smoothing well-connected nodes. LGAT therefore adaptively balances these two perspectives based on each node’s structural role. Specifically, LGAT employs a hybrid temporal decay mechanism that combines fixed exponential decay with dynamic time decay to model temporal dependencies, quantifies mutual neighbor co-occurrence frequencies to capture fine-grained local topology, and maintains a global evolutionary representation that disproportionately benefits under-represented nodes through inverse-degree weighting. Furthermore, LGAT introduces a contrastive pretext task that enriches supervision signals by maximizing mutual information between interacting node pairs, directly mitigating the edge sparsity problem. Extensive experiments on six real-world datasets demonstrate that LGAT significantly outperforms state-of-theart methods, with particularly pronounced improvements on networks exhibiting strong heterogeneity and sparsity.},
  code = {https://github.com/hjchen-hdu/ST-TGExplainer},
  rank = {EI},
}

@article{chen2026tgformer,
  title={TGFormer: Towards temporal graph transformer with auto-correlation mechanism},
  author={Chen, Hongjiang and Jiao, Pengfei and Du, Ming and Guo, Xuan and Zhao, Zhidong and Jin, Di and Liu, Xiao},
  journal={Pattern Recognition},
  volume={170},
  pages={112053},
  year={2026},
  publisher={Elsevier},
  selected = {true},
  paper = {https://arxiv.org/abs/2605.24971},
  abstract = {The growing interest in Temporal Graph Neural Networks (TGNNs) stems from their ability to model complex dynamics and deliver superior performance. However, TGNNs encounter fundamental challenges in capturing long-term dependencies and identifying periodic patterns. To address these limitations, we propose TGFormer, a novel Transformer architecture specifically designed for temporal graphs. Our model redefines temporal graph learning by establishing a trajectory framework that aligns with time series analysis principles. This approach allows TGFormer to derive node representations through systematic analysis of historical interactions, enabling granular examination of node relationships across sequential timestamps. Building upon stochastic process theory, we develop an auto-correlation mechanism that systematically uncovers periodic dependencies in node interactions. This innovation empowers TGFormer to perform dependency discovery and representation aggregation at sub-interaction levels, demonstrating superior efficiency and accuracy compared to conventional attention mechanisms. Experimental validation across six public benchmarks confirms the effectiveness of our approach, with TGFormer at most achieving 9.35\% precision improvement compared to state-of-the-art approaches.},
  code = {https://github.com/hjchen-hdu/TGFormer},
  rank = {CCF-B},
}

@inproceedings{jiao2025survey,
  title={A survey on temporal interaction graph representation learning: progress, challenges, and opportunities},
  author={Jiao, Pengfei and Chen, Hongjiang and Guo, Xuan and Zhao, Zhidong and He, Dongxiao and Jin, Di},
  booktitle={Proceedings of the Thirty-Fourth International Joint Conference on Artificial Intelligence},
  pages={10499--10507},
  year={2025},
  selected = {false},
  paper = {https://arxiv.org/abs/2505.04461},
  abstract = {Temporal interaction graphs (TIGs), defined by sequences of timestamped interaction events, have become ubiquitous in real-world applications due to their capability to model complex dynamic system behaviors. As a result, temporal interaction graph representation learning (TIGRL) has garnered significant attention in recent years. TIGRL aims to embed nodes in TIGs into low-dimensional representations that effectively preserve both structural and temporal information, thereby enhancing the performance of downstream tasks such as classification, prediction, and clustering within constantly evolving data environments. In this paper, we begin by introducing the foundational concepts of TIGs and emphasize the critical role of temporal dependencies. We then propose a comprehensive taxonomy of state-of-the-art TIGRL methods, systematically categorizing them based on the types of information utilized during the learning process to address the unique challenges inherent to TIGs. To facilitate further research and practical applications, we curate the source of datasets and benchmarks, providing valuable resources for empirical investigations. Finally, we examine key open challenges and explore promising research directions in TIGRL, laying the groundwork for future advancements that have the potential to shape the evolution of this field.},
  rank = {CCF-A},
}

@inproceedings{chen2023temporal,
  title={Temporal graph representation learning with adaptive augmentation contrastive},
  author={Chen, Hongjiang and Jiao, Pengfei and Tang, Huijun and Wu, Huaming},
  booktitle={Joint European conference on machine learning and knowledge discovery in databases},
  pages={683--699},
  year={2023},
  organization={Springer},
  selected = {false},
  paper = {https://arxiv.org/abs/2311.03897},
  abstract = {Temporal graph representation learning aims to generate low-dimensional dynamic node embeddings to capture temporal information as well as structural and property information. Current representation learning methods for temporal networks often focus on capturing fine-grained information, which may lead to the model capturing random noise instead of essential semantic information. While graph contrastive learning has shown promise in dealing with noise, it only applies to static graphs or snapshots and may not be suitable for handling time-dependent noise. To alleviate the above challenge, we propose a novel Temporal Graph representation learning with Adaptive augmentation Contrastive (TGAC) model. The adaptive augmentation on the temporal graph is made by combining prior knowledge with temporal information, and the contrastive objective function is constructed by defining the augmented inter-view contrast and intra-view contrast. To complement TGAC, we propose three adaptive augmentation strategies that modify topological features to reduce noise from the network. Our extensive experiments on various real networks demonstrate that the proposed model outperforms other temporal graph representation learning methods.},
  code = {https://github.com/hjchen-hdu/TGAC},
  rank = {CCF-B},
}

@article{jiao2024contrastive,
  title={Contrastive representation learning on dynamic networks},
  author={Jiao, Pengfei and Chen, Hongjiang and Tang, Huijun and Bao, Qing and Zhang, Long and Zhao, Zhidong and Wu, Huaming},
  journal={Neural Networks},
  volume={174},
  pages={106240},
  year={2024},
  publisher={Elsevier},
  selected = {false},
  paper = {https://doi.org/10.1016/j.neunet.2024.106240},
  abstract = {Representation learning for dynamic networks is designed to learn low-dimensional node embeddings that preserve snapshot structure, node properties, and temporal evolution. Existing methods often focus on estimating or generating observed snapshot structures, which can over-emphasize network details and reduce robustness under sparse or noisy conditions. This paper proposes Dynamic Network Contrastive representation Learning (DNCL), which uses intra-snapshot and inter-snapshot contrastive objectives to capture topology, node features, and network evolution. Experiments on link prediction, node classification, and clustering demonstrate the effectiveness of the proposed method.},
  rank = {CCF-B},
}

@inproceedings{jiao2025hgmp,
  title={HGMP: Heterogeneous Graph Multi-Task Prompt Learning},
  author={Jiao, Pengfei and Ni, Jialong and Jin, Di and Guo, Xuan and Liu, Huan and Chen, Hongjiang and Bi, Yanxian},
  booktitle={Proceedings of the Thirty-Fourth International Joint Conference on Artificial Intelligence},
  pages={2982--2990},
  year={2025},
  selected = {false},
  paper = {https://arxiv.org/abs/2507.07405},
  doi = {10.24963/ijcai.2025/332},
  abstract = {Pre-training and fine-tuning methods are widely used in heterogeneous graph neural networks, but the mismatch between pre-trained models and downstream tasks can lead to suboptimal performance. HGMP proposes a heterogeneous graph multi-task prompt framework that reformulates downstream tasks into a unified graph-level format, designs a graph-level contrastive pre-training strategy, and introduces heterogeneous feature prompts to improve multi-task performance. Experiments on public datasets show that HGMP adapts well to various tasks and outperforms baseline methods.},
  rank = {CCF-A},
}

@article{chen2026goagent,
  title={GoAgent: Group-of-Agents Communication Topology Generation for LLM-based Multi-Agent Systems},
  author={Chen, Hongjiang and Zheng, Xin and Liu, Yixin and Jiao, Pengfei and Li, Shiyuan and Liu, Huan and Zhao, Zhidong and Xu, Ziqi and Khalil, Ibrahim and Pan, Shirui},
  journal={arXiv preprint arXiv:2603.19677},
  year={2026},
  selected = {false},
  paper = {https://arxiv.org/abs/2603.19677},
  abstract = {Large language model based multi-agent systems rely heavily on communication topology for effective coordination. GoAgent proposes a group-of-agents communication topology generation method that treats collaborative groups as atomic units. It first enumerates task-relevant candidate groups with an LLM, then autoregressively selects and connects these groups to form a final communication graph. A conditional information bottleneck objective compresses inter-group communication and filters redundant historical noise. Experiments on six benchmarks show strong performance while reducing token consumption.},
  rank = {Arxiv}
}

@article{chen2026empirical,
  title={An Empirical Study Challenging the Ability of Heterogeneous Graph Neural Networks to Effectively Learn Topological Structures},
  author={Chen, Shuxin and Guo, Xuan and Liu, Huan and Chen, Hongjiang and Jiao, Pengfei},
  journal={IEEE Transactions on Big Data},
  year={2026},
  issn={2332-7790},
  doi={10.1109/TBDATA.2026.3668622},
  selected = {false},
  paper = {https://doi.org/10.1109/TBDATA.2026.3668622},
  abstract = {The utilization of graph neural networks in heterogeneous networks has been rapidly increasing in recent years. The topological structure, fundamental to the nature of graphs, is often claimed to be jointly addressed with attribute information by most heterogeneous graph neural network approaches. This work empirically challenges these claims within existing evaluation frameworks and shows that current protocols may contain systemic biases that fail to distinguish superficial adjacency exploitation from genuine structural pattern learning.},
  rank = {CCF-C},
}
